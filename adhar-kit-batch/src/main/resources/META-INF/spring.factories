# Defaults needed before the context exists: framework loggers that print job parameters,
# spring.batch.job.enabled=false with the embedded scheduler, and Kubernetes mode (design 0025 5.5).
org.springframework.boot.EnvironmentPostProcessor=\
com.adhar.kit.batch.config.BatchRuntimeEnvironmentPostProcessor

# The kit's JobRepository schema migration is a database initializer: Spring Boot makes the
# JobRepository (and JPA) wait for it. So is its Quartz stream (engine quartz): Spring Boot's
# Quartz scheduler waits for the Quartz tables.
org.springframework.boot.sql.init.dependency.DatabaseInitializerDetector=\
com.adhar.kit.batch.repository.BatchSchemaMigratorDetector,\
com.adhar.kit.batch.repository.QuartzSchemaMigratorDetector
