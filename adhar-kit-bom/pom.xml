<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.adhar.kit</groupId>
    <artifactId>adhar-kit-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Adhar Kit BOM</name>
    <description>Bill of Materials for Adhar Kit - Enterprise Microservices Foundation</description>

    <repositories>
        <!-- Lombok edge build for Java 25 support (still pre-release) -->
        <repository>
            <id>projectlombok.org</id>
            <url>https://projectlombok.org/edge-releases</url>
        </repository>
    </repositories>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Adhar Kit Version -->
        <adhar-kit.version>0.1.0-SNAPSHOT</adhar-kit.version>

        <!-- Spring Ecosystem - Spring Boot 4.1.0 ships with Spring Framework 7.0.8 -->
        <!-- spring-kafka/spring-amqp, micrometer, jakarta APIs, flyway, liquibase,
             mockito, byte-buddy, awaitility, janino and testcontainers are all
             managed by the Spring Boot 4.1 BOM - do not override them here. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-framework.version>7.0.8</spring-framework.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>

        <!-- Code Generation -->
        <lombok.version>edge-SNAPSHOT</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- Resilience & Observability -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <opentelemetry.version>1.63.0</opentelemetry.version>

        <!-- Logging -->
        <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>

        <!-- Persistence -->
        <querydsl.version>5.1.0</querydsl.version>

        <!-- API Documentation -->
        <springdoc-openapi.version>3.0.3</springdoc-openapi.version>

        <!-- gRPC -->
        <grpc.version>1.82.0</grpc.version>
        <protobuf.version>4.35.1</protobuf.version>

        <!-- Cloud Native -->
        <dapr-sdk.version>1.18.0</dapr-sdk.version>
        <kubernetes-client.version>7.7.0</kubernetes-client.version>

        <!-- AI Integration -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <langchain4j.version>1.16.3</langchain4j.version>

        <!-- Analytics -->
        <posthog.version>1.2.0</posthog.version>

        <!-- Testing -->
        <wiremock.version>3.13.1</wiremock.version>

        <!-- CloudEvents -->
        <cloudevents.version>4.1.1</cloudevents.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers is managed by the Spring Boot 4.1 BOM (2.x) -->

            <!-- ========== ADHAR KIT MODULES ========== -->

            <!-- Core & Commons -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-commons</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-core</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-test-commons</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Configuration -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-config</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Persistence -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-persistence</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Caching -->
            <dependency>
                <groupId>com.adhar.adharkit</groupId>
                <artifactId>adhar-kit-cache</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Messaging -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-messaging</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Observability -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-logging</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-metrics</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-tracing</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-health</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Resilience -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-resilience</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Security -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-security</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- API Documentation -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-docs</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- gRPC -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-grpc</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Cloud Native -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-kubernetes</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-dapr</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- AI & Machine Learning -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-ai</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Analytics -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-analytics</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>


            <!-- GraphQL -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-graphql</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Batch Processing -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-batch</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Notification -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-notification</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Event Sourcing -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-event-sourcing</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Performance Profiler -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-perf-profiler</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- OpenRewrite Code Modernization -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-rewrite</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- All-in-One Starter -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-starter</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Maven Plugin -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-maven-plugin</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- ========== THIRD-PARTY DEPENDENCIES ========== -->

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- CloudEvents -->
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-core</artifactId>
                <version>${cloudevents.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cloudevents</groupId>
                <artifactId>cloudevents-json-jackson</artifactId>
                <version>${cloudevents.version}</version>
            </dependency>

            <!-- Resilience4j - Spring Boot 4 compatible -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Resilience4j BOM for consistent versions -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Micrometer & Micrometer Tracing are managed by the Spring Boot 4.1 BOM -->

            <!-- OpenTelemetry -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- QueryDSL -->
            <dependency>
                <groupId>com.querydsl</groupId>
                <artifactId>querydsl-jpa</artifactId>
                <version>${querydsl.version}</version>
                <classifier>jakarta</classifier>
            </dependency>

            <!-- gRPC -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Dapr SDK -->
            <dependency>
                <groupId>io.dapr</groupId>
                <artifactId>dapr-sdk</artifactId>
                <version>${dapr-sdk.version}</version>
            </dependency>

            <!-- Kubernetes Client -->
            <dependency>
                <groupId>io.fabric8</groupId>
                <artifactId>kubernetes-client</artifactId>
                <version>${kubernetes-client.version}</version>
            </dependency>

            <!-- Spring AI 2.0 BOM - manages all spring-ai-* artifact versions -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- LangChain4j -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <!-- PostHog Analytics -->
            <dependency>
                <groupId>com.posthog.java</groupId>
                <artifactId>posthog</artifactId>
                <version>${posthog.version}</version>
            </dependency>

            <!-- Logstash Encoder -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- Janino, Byte Buddy and Mockito are managed by the Spring Boot 4.1 BOM -->

            <!-- WireMock -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>

            <!-- Awaitility is managed by the Spring Boot 4.1 BOM -->
        </dependencies>
    </dependencyManagement>
</project>