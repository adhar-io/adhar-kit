<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.adhar.kit</groupId>
    <artifactId>adhar-kit-bom</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Adhar Kit BOM</name>
    <description>Bill of Materials for Adhar Kit - Enterprise Microservices Foundation</description>

    <repositories>
        <repository>
            <id>projectlombok.org</id>
            <url>https://projectlombok.org/edge-releases</url>
        </repository>
    </repositories>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Adhar Kit Version -->
        <adhar-kit.version>1.0.0</adhar-kit.version>

        <!-- Spring Ecosystem -->
        <spring-boot.version>3.4.1</spring-boot.version>
        <spring-framework.version>6.2.1</spring-framework.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <spring-kafka.version>3.3.0</spring-kafka.version>
        <spring-rabbit.version>3.2.0</spring-rabbit.version>

        <!-- Code Generation -->
        <lombok.version>edge-SNAPSHOT</lombok.version>
        <mapstruct.version>1.6.0</mapstruct.version>

        <!-- Resilience & Observability -->
        <resilience4j.version>2.3.0</resilience4j.version>
        <micrometer.version>1.15.0</micrometer.version>
        <micrometer-tracing.version>1.5.0</micrometer-tracing.version>
        <opentelemetry.version>1.45.0</opentelemetry.version>

        <!-- Logging -->
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <janino.version>3.1.10</janino.version>

        <!-- Persistence -->
        <jakarta-persistence.version>3.2.0</jakarta-persistence.version>
        <jakarta-validation.version>3.1.0</jakarta-validation.version>
        <querydsl.version>5.1.0</querydsl.version>
        <flyway.version>10.20.0</flyway.version>
        <liquibase.version>4.30.0</liquibase.version>

        <!-- API Documentation -->
        <springdoc-openapi.version>2.8.0</springdoc-openapi.version>

        <!-- gRPC -->
        <grpc.version>1.70.0</grpc.version>
        <protobuf.version>4.29.0</protobuf.version>
        <grpc-spring-boot-starter.version>3.2.0</grpc-spring-boot-starter.version>

        <!-- Cloud Native -->
        <dapr-sdk.version>1.14.0</dapr-sdk.version>
        <kubernetes-client.version>7.1.0</kubernetes-client.version>

        <!-- AI Integration -->
        <spring-ai.version>1.0.0</spring-ai.version>
        <langchain4j.version>0.38.0</langchain4j.version>

        <!-- Analytics -->
        <posthog.version>3.1.1</posthog.version>

        <!-- Testing -->
        <testcontainers.version>1.20.4</testcontainers.version>
        <mockito.version>5.15.2</mockito.version>
        <byte-buddy.version>1.17.0</byte-buddy.version>
        <wiremock.version>3.10.0</wiremock.version>
        <awaitility.version>4.2.2</awaitility.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== ADHAR KIT MODULES ========== -->

            <!-- Core & Commons -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-commons</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-core</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-test-commons</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Configuration -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-config</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Persistence -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-persistence</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Caching -->
            <dependency>
                <groupId>com.adhar.adharkit</groupId>
                <artifactId>adhar-kit-cache</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Messaging -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-messaging</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Observability -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-logging</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-metrics</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-tracing</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-health</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Resilience -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-resilience</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Security -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-security</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- API Documentation -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-docs</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- gRPC -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-grpc</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Cloud Native -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-kubernetes</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-dapr</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- AI & Machine Learning -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-ai</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Analytics -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-analytics</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>


            <!-- All-in-One Starter -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-starter</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- Maven Plugin -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-maven-plugin</artifactId>
                <version>${adhar-kit.version}</version>
            </dependency>

            <!-- ========== THIRD-PARTY DEPENDENCIES ========== -->

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- Resilience4j -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Micrometer -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>

            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-tracing</artifactId>
                <version>${micrometer-tracing.version}</version>
            </dependency>

            <!-- OpenTelemetry -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- QueryDSL -->
            <dependency>
                <groupId>com.querydsl</groupId>
                <artifactId>querydsl-jpa</artifactId>
                <version>${querydsl.version}</version>
                <classifier>jakarta</classifier>
            </dependency>

            <!-- gRPC -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Dapr SDK -->
            <dependency>
                <groupId>io.dapr</groupId>
                <artifactId>dapr-sdk</artifactId>
                <version>${dapr-sdk.version}</version>
            </dependency>

            <!-- Kubernetes Client -->
            <dependency>
                <groupId>io.fabric8</groupId>
                <artifactId>kubernetes-client</artifactId>
                <version>${kubernetes-client.version}</version>
            </dependency>

            <!-- Spring AI - Optional, managed in AI module -->
            <!--
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            -->

            <!-- LangChain4j -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <!-- PostHog Analytics -->
            <dependency>
                <groupId>com.posthog.java</groupId>
                <artifactId>posthog</artifactId>
                <version>${posthog.version}</version>
            </dependency>

            <!-- Logstash Encoder -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- Janino (for Logback conditions) -->
            <dependency>
                <groupId>org.codehaus.janino</groupId>
                <artifactId>janino</artifactId>
                <version>${janino.version}</version>
            </dependency>

            <!-- Byte Buddy (for testing with Java 25) -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>

            <!-- Mockito (Java 25 compatible) -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>

            <!-- WireMock -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>

            <!-- Awaitility -->
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>