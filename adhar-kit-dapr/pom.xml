<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.adhar.kit</groupId>
        <artifactId>adhar-kit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../adhar-kit-parent/pom.xml</relativePath>
    </parent>
    <artifactId>adhar-kit-dapr</artifactId>
    <name>Adhar Kit Dapr</name>
    <description>Comprehensive Dapr integration - State, Pub/Sub, Service Invocation, Bindings, Actors, Secrets, Configuration</description>

    <properties>
        <dapr-sdk.version>1.18.0</dapr-sdk.version>
    </properties>

    <dependencies>
        <!-- Dapr SDK -->
        <dependency>
            <groupId>io.dapr</groupId>
            <artifactId>dapr-sdk</artifactId>
            <version>${dapr-sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>io.dapr</groupId>
            <artifactId>dapr-sdk-springboot</artifactId>
            <version>${dapr-sdk.version}</version>
        </dependency>

        <!-- Dapr Actors SDK (optional) - actor runtime registration + typed actor proxies.
             Optional so that consumers not using actors don't pull it transitively; it is
             still present on this module's own compile/test classpath. -->
        <dependency>
            <groupId>io.dapr</groupId>
            <artifactId>dapr-sdk-actors</artifactId>
            <version>${dapr-sdk.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Dapr Workflows SDK (optional) - start/terminate/status/raise-event facade.
             Optional for the same reason as the actors SDK above. -->
        <dependency>
            <groupId>io.dapr</groupId>
            <artifactId>dapr-sdk-workflows</artifactId>
            <version>${dapr-sdk.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Adhar Kit Commons -->
        <dependency>
            <groupId>com.adhar.kit</groupId>
            <artifactId>adhar-kit-commons</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- AOP support for @DaprState/@DaprPublish aspects (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>