{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "title": "Adhar Kit - SLO & Error Budget",
  "uid": "adhar-slo",
  "tags": ["adhar-kit", "slo", "error-budget"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(adhar_slo_error_budget_remaining, target)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Error budget",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Error budget remaining",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "adhar_slo_error_budget_remaining{target=~\"$target\"}",
          "legendFormat": "{{target}} (obj {{objective}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error budget remaining over time",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "adhar_slo_error_budget_remaining{target=~\"$target\"}",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Burn rate",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Burn rate (observed / allowed error rate)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "adhar_slo_burn_rate{target=~\"$target\"}",
          "legendFormat": "{{target}} (obj {{objective}})"
        }
      ]
    },
    {
      "type": "table",
      "title": "SLO targets summary",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "adhar_slo_error_budget_remaining{target=~\"$target\"}"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "adhar_slo_burn_rate{target=~\"$target\"}"
        }
      ]
    }
  ]
}
