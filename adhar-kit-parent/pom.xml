        <!-- Framework Support -->
        <helidon.version>4.5.0</helidon.version>
        <vertx.version>5.1.2</vertx.version>

        <!-- Testing dependencies -->
        <rest-assured.version>6.0.0</rest-assured.version>

        <!-- ===================================================================== -->
        <!-- API Technologies                                                       -->
        <!-- ===================================================================== -->
        <!-- GraphQL support for flexible APIs (aligned with Spring GraphQL 2.0.x) -->
        <graphql-java.version>25.0</graphql-java.version>

        <!-- ===================================================================== -->
        <!-- Native Compilation                                                     -->
        <!-- ===================================================================== -->
        <!-- GraalVM Native Image for fast startup and low memory -->
        <native-maven-plugin.version>1.1.2</native-maven-plugin.version>

        <!-- ===================================================================== -->
        <!-- Cloud Provider SDKs                                                    -->
        <!-- ===================================================================== -->
        <!-- Multi-cloud support: AWS, Azure, GCP -->
        <aws-sdk.version>2.46.14</aws-sdk.version>
        <azure-sdk.version>1.18.0</azure-sdk.version>
        <google-cloud.version>26.84.0</google-cloud.version>

        <!-- ===================================================================== -->
        <!-- Observability & Tracing                                                -->
        <!-- ===================================================================== -->
        <!-- OpenTelemetry for vendor-neutral observability -->
        <opentelemetry.version>1.63.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.29.0</opentelemetry-instrumentation.version>

        <!-- Kafka Streams is managed by the Spring Boot 4.1 BOM -->

        <!-- ===================================================================== -->
        <!-- Maven Plugin Versions                                                  -->
        <!-- ===================================================================== -->
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.3</maven-failsafe-plugin.version>
        <maven-release-plugin.version>3.1.1</maven-release-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-deploy-plugin.version>3.1.3</maven-deploy-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.7.0</central-publishing-plugin.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
        <versions-maven-plugin.version>2.18.0</versions-maven-plugin.version>

        <!-- ===================================================================== -->
        <!-- Quality & Testing Configuration                                        -->
        <!-- ===================================================================== -->
        <!-- Minimum 80% instruction coverage enforced for every module
             (tests target >90%; the gate sits at 80% for build stability). -->
        <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
    </properties>
    
    <dependencyManagement>
        <dependencies>
            <!-- ================================================================= -->
            <!-- Security floors — CVE remediation above the Spring Boot BOM       -->
            <!-- ================================================================= -->
            <!-- Every app built on this parent inherited 29 HIGH/CRITICAL findings
                 from the Spring Boot 4.1.0 BOM, which the supply-chain image scan
                 gate (trivy at severity HIGH,CRITICAL with exit-code 1) correctly
                 refuses. Measured on a scaffolded service image: 20 HIGH + 9
                 CRITICAL in the `Java (jar)` target, which dwarfed everything else
                 in the image.

                 Pinned as explicit dependencyManagement rather than version
                 PROPERTIES on purpose: a property name that the BOM does not
                 actually use (they differ per artifact, and Jackson 3 /
                 BouncyCastle do not follow the obvious pattern) is silently
                 ignored, and the build then looks fixed while shipping the same
                 jars. An explicit managed version always wins over an imported
                 BOM, so these are verifiable by `mvn dependency:tree`.

                 Versions are the FIXED versions the scanner reported, not
                 guesses. Remove an entry once the inherited BOM moves past it;
                 `mvn dependency:tree` showing the same version with and without
                 the pin is the signal it is redundant. -->

            <!-- CRITICAL CVE-2026-47884 / CVE-2026-47890 / CVE-2026-47892:
                 Spring Framework remote code execution and header handling. -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>7.0.9</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- CRITICAL CVE-2026-65182 (security-constraint bypass),
                 CVE-2026-65905 (authentication bypass), CVE-2026-68525. -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>11.0.25</version>
            </dependency>

            <!-- CRITICAL CVE-2026-75595: SNI routing bypass in netty-handler.
                 The rest of Netty needs 4.2.16 for the DoS set (CVE-2026-55831,
                 -55833, -56745, -56816, -56819, -59901); 4.2.17 covers both, so
                 the whole BOM moves together rather than splitting the versions. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.17.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- HIGH CVE-2026-89407 / -89425 / -68497 / -91776 / -91777.
                 BOTH Jackson lines are on the classpath here: 2.x under
                 com.fasterxml.jackson and 3.x under tools.jackson. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>3.1.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- HIGH CVE-2026-54399 / CVE-2026-54428: Apache HttpCore 5. -->
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>5.4.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>5.4.3</version>
            </dependency>

            <!-- HIGH CVE-2026-8763 / CVE-2026-13506: BouncyCastle DoS. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.85</version>
            </dependency>

            <!-- HIGH CVE-2026-54291: scram-client, reached through the driver. -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.12</version>
            </dependency>

            <!-- ================================================================= -->
            <!-- Adhar Kit BOM                                                     -->
            <!-- ================================================================= -->
            <!-- Centralized version management for all Adhar Kit modules          -->
            <!-- Import this BOM to ensure consistent versions across all modules  -->
            <dependency>
                <groupId>com.adhar.kit</groupId>
                <artifactId>adhar-kit-bom</artifactId>
                <version>${adhar-kit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ================================================================= -->
            <!-- Spring Boot Components                                            -->
            <!-- ================================================================= -->
            <!-- Explicit versions for Spring Boot 4.0 components -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-aspectj</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-webmvc</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-actuator</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-jpa</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-security</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-validation</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>

            <!-- ================================================================= -->
            <!-- Helidon BOM                                                       -->
            <!-- ================================================================= -->
            <dependency>
                <groupId>io.helidon</groupId>
                <artifactId>helidon-bom</artifactId>
                <version>${helidon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ================================================================= -->
            <!-- Vert.x BOM                                                        -->
            <!-- ================================================================= -->
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-stack-depchain</artifactId>
                <version>${vertx.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ================================================================= -->
            <!-- Testing Dependencies                                              -->
            <!-- ================================================================= -->
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>

            <!-- ================================================================= -->
            <!-- Lombok                                                            -->
            <!-- ================================================================= -->
            <!-- Java 25+ compatible Lombok for reducing boilerplate code         -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- ================================================================= -->
            <!-- Cloud Provider SDKs                                               -->
            <!-- ================================================================= -->

            <!-- AWS SDK v2 - Comprehensive AWS services support -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Azure SDK - Microsoft Azure services support - Optional -->
            <!--
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            -->

            <!-- Google Cloud SDK - GCP services support -->
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${google-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ================================================================= -->
            <!-- OpenTelemetry                                                     -->
            <!-- ================================================================= -->
            <!-- Vendor-neutral observability framework for traces, metrics, logs -->

            <!-- Core OpenTelemetry API and SDK -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- OpenTelemetry instrumentation libraries -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
                <version>${opentelemetry-instrumentation.version}-alpha</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- HIGH CVE-2026-106451: lz4-java insecure temporary file handling.
                 kafka-clients (through spring-kafka in the Boot BOM) brings
                 1.10.1; every service with adhar-kit-messaging failed the
                 image scan on it (2026-10-15). -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <!-- io.kubernetes:client-java, reached through
                 spring-cloud-starter-kubernetes-client-all in adhar-kit-kubernetes;
                 the version the Spring Cloud BOM manages carried HIGH findings
                 in the scaffolded service's image. -->
            <dependency>
                <groupId>io.kubernetes</groupId>
                <artifactId>client-java</artifactId>
                <version>27.0.0</version>
            </dependency>
            <!-- HIGH CVE-2026-102554: Guava before 33.7.2. The Vert.x BOM
                 imported above (vertx-stack-depchain -> vertx-dependencies
                 5.1.2) manages Guava at 32.1.2-jre, and as the first import to
                 name it, it set the version for every module and every app on
                 this parent: adhar-kit-core asked for 33.4.0-jre, services
                 resolved 32.1.2-jre, and a scaffolded springboot-web-service
                 failed its image scan on it (2026-10-30). An explicit entry
                 outranks every imported BOM; failureaccess is managed by none
                 of them, so Guava's own 1.0.3 comes with it. graphql-java
                 shades a Guava 32.1.2-jre of its own that no pin reaches, which
                 is why adhar-kit-graphql keeps graphql-java optional. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <!-- HIGH CVE-2026-108106 / CVE-2026-93451 and MEDIUM CVE-2026-116590:
                 snappy-java before 1.1.10.9. kafka-clients 4.2.1 (Spring Boot
                 4.1.0, through spring-kafka in adhar-kit-messaging) brings
                 1.1.10.7 and no imported BOM manages it, the same way it brings
                 lz4-java above. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>

            <!-- ================================================================= -->
            <!-- Streaming & Analytics                                             -->
            <!-- ================================================================= -->
            <!-- Kafka Streams version is managed by the Spring Boot 4.1 BOM       -->

            <!-- ================================================================= -->
            <!-- Spring Boot Dependencies                                          -->
            <!-- ================================================================= -->
            <!-- All Spring Boot dependencies are inherited from                   -->
            <!-- spring-boot-starter-parent and managed by Spring Boot BOM        -->
        </dependencies>
    </dependencyManagement>
    
    <dependencies>
        <!-- ===================================================================== -->
        <!-- Common Dependencies for All Child Modules                             -->
        <!-- ===================================================================== -->
        <!-- These dependencies are automatically inherited by all child modules   -->

        <!-- Spring Boot Starter - Core Spring Boot functionality -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot Test - Comprehensive testing support with JUnit 5 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- ============================================================= -->
                <!-- Spring Boot Maven Plugin                                      -->
                <!-- ============================================================= -->
                <!-- Packages executable JAR/WAR, manages classpath, runs app     -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- Exclude Lombok from final JAR (compile-time only) -->
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Compiler Plugin                                         -->
                <!-- ============================================================= -->
                <!-- Compiles Java source with Java 25 and Lombok support        -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <!-- Lombok annotation processor for code generation -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <!-- Preserve parameter names for better debugging -->
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Surefire Plugin - Unit Tests                           -->
                <!-- ============================================================= -->
                <!-- Executes unit tests during 'test' phase                      -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- JaCoCo coverage + 1GB heap for tests -->
                        <argLine>@{argLine} -Xmx1024m</argLine>
                        <!-- Include standard test file patterns -->
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                        <!-- Global per-test timeout: a hung test (e.g. an unbounded
                             future join) fails fast instead of blocking the whole
                             build indefinitely, keeping 'mvn clean install' reliable. -->
                        <properties>
                            <configurationParameters>
                                junit.jupiter.execution.timeout.default = 5 m
                            </configurationParameters>
                        </properties>
                    </configuration>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Failsafe Plugin - Integration Tests                    -->
                <!-- ============================================================= -->
                <!-- Executes integration tests with proper lifecycle             -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <!-- Run integration tests -->
                                <goal>integration-test</goal>
                                <!-- Verify test results -->
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================= -->
                <!-- JaCoCo Code Coverage Plugin                                   -->
                <!-- ============================================================= -->
                <!-- Measures code coverage and enforces minimum threshold        -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <configuration>
                        <!-- Exclude classes that don't need coverage -->
                        <excludes>
                            <!-- Annotations -->
                            <exclude>**/annotation/**</exclude>
                            <!-- Configuration properties (POJOs) -->
                            <exclude>**/*Properties.class</exclude>
                            <exclude>**/*Properties$*.class</exclude>
                            <!-- Auto-configuration classes -->
                            <exclude>**/*AutoConfiguration.class</exclude>
                            <exclude>**/*AutoConfiguration$*.class</exclude>
                            <!-- Constants -->
                            <exclude>**/*Constants.class</exclude>
                            <!-- Framework-specific adapters (excluded from compilation) -->
                            <exclude>**/quarkus/**</exclude>
                            <exclude>**/micronaut/**</exclude>
                            <exclude>**/helidon/**</exclude>
                            <exclude>**/vertx/**</exclude>
                            <!-- Models adhar:openapi generates from a spec
                                 (<basePackage>.api|client.v<major>.model): accessors,
                                 equals and toString derived from the spec, which would
                                 hold a well-tested service under the 80% gate. The
                                 generated interfaces have no bytecode to cover. -->
                            <exclude>**/api/v?/model/**</exclude>
                            <exclude>**/api/v??/model/**</exclude>
                            <exclude>**/client/v?/model/**</exclude>
                            <exclude>**/client/v??/model/**</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <!-- Prepare JaCoCo agent for test instrumentation -->
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <!-- Generate coverage report after tests -->
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <!-- Enforce minimum coverage threshold -->
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <!-- Minimum 50% code coverage (global default) -->
                                                <minimum>${jacoco.minimum.coverage}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Release Plugin                                          -->
                <!-- ============================================================= -->
                <!-- Automates versioning and release process                     -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                    <configuration>
                        <!-- Sync version across all modules -->
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <useReleaseProfile>false</useReleaseProfile>
                        <releaseProfiles>release</releaseProfiles>
                        <goals>deploy</goals>
                        <!-- Tag format: v0.1.0 -->
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                    </configuration>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Enforcer Plugin                                         -->
                <!-- ============================================================= -->
                <!-- Enforces build environment requirements                       -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-maven</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <!-- Require Maven 3.8+ -->
                                    <requireMavenVersion>
                                        <version>[3.8,)</version>
                                    </requireMavenVersion>
                                    <!-- Require Java 25+ -->
                                    <requireJavaVersion>
                                        <version>[25,)</version>
                                    </requireJavaVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Source Plugin                                           -->
                <!-- ============================================================= -->
                <!-- Generates source JAR for better IDE integration             -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Javadoc Plugin                                          -->
                <!-- ============================================================= -->
                <!-- Generates API documentation from JavaDoc comments            -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <!-- Disable strict doclint for flexible documentation -->
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================= -->
                <!-- Versions Maven Plugin                                         -->
                <!-- ============================================================= -->
                <!-- Helps manage dependency and plugin versions                  -->
                <!-- Usage: mvn versions:display-dependency-updates              -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven GPG Plugin - Artifact Signing                           -->
                <!-- ============================================================= -->
                <!-- Signs artifacts with GPG for Maven Central publishing        -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================= -->
                <!-- Central Publishing Plugin - Maven Central Deployment          -->
                <!-- ============================================================= -->
                <!-- Publishes to Maven Central via Sonatype Central Portal       -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-plugin.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>true</autoPublish>
                        <waitUntil>published</waitUntil>
                    </configuration>
                </plugin>

                <!-- ============================================================= -->
                <!-- Maven Deploy Plugin                                           -->
                <!-- ============================================================= -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>

                <!-- ============================================================= -->
                <!-- Adhar Kit Maven Plugin - spec-first OpenAPI                   -->
                <!-- ============================================================= -->
                <!-- A service declares only groupId and artifactId and gets
                     openapi-lint at validate and openapi at generate-sources: the
                     API contract is checked, then api/v<major>/openapi.yaml becomes
                     <basePackage>.api.v<major> interfaces and models and ships in
                     the jar. Both goals do nothing without a spec. The code they
                     generate needs spring-boot-starter-webmvc and
                     spring-boot-starter-validation (adhar-kit-core brings both);
                     every version involved is managed by the Spring Boot BOM.

                     Managed here and never bound in <build><plugins>: this parent
                     also builds adhar-kit-maven-plugin, which would then have to be
                     built before itself. -->
                <plugin>
                    <groupId>com.adhar.kit</groupId>
                    <artifactId>adhar-kit-maven-plugin</artifactId>
                    <version>${adhar-kit.version}</version>
                    <executions>
                        <execution>
                            <id>adhar-openapi-lint</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>openapi-lint</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>adhar-openapi</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>openapi</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- ================================================================= -->
            <!-- Plugins Applied to All Child Modules                             -->
            <!-- ================================================================= -->

            <!-- Apply JaCoCo code coverage to all modules -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!-- Apply Maven Enforcer to all modules -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- ===================================================================== -->
    <!-- Distribution Management for Maven Central                            -->
    <!-- ===================================================================== -->
    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

</project>
