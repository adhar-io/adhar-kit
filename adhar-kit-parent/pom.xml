        <!-- ===================================================================== -->
        <!-- Adhar Kit Version Management                                          -->
        <!-- ===================================================================== -->
        <adhar-kit.version>0.1.0</adhar-kit.version>

        <!-- ===================================================================== -->
        <!-- Core Dependencies                                                      -->
        <!-- ===================================================================== -->
