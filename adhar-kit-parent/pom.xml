        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Default empty argLine so surefire's @{argLine} resolves when JaCoCo
             (which sets this property) is inactive, e.g. plain `mvn test`. -->
