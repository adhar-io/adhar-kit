<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.adhar.kit</groupId>
        <artifactId>adhar-kit-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../adhar-kit-parent/pom.xml</relativePath>
    </parent>
    <artifactId>adhar-kit-persistence</artifactId>
    <version>0.1.0</version>
    <name>adhar-kits-persistence</name>
    <description>adhar-persistence-starter</description>

    <properties>
    </properties>

    <dependencies>
        <!-- Adhar Kit Commons -->
        <dependency>
            <groupId>com.adhar.kit</groupId>
            <artifactId>adhar-kit-commons</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dapr Dependencies (Optional) - powers the Dapr state-store backed
             DaprStateRepository. Gated at runtime by @ConditionalOnClass(DaprFacade)
             and the explicit opt-in property adhar.dapr.enabled=true. -->
        <dependency>
            <groupId>com.adhar.kit</groupId>
            <artifactId>adhar-kit-dapr</artifactId>
            <version>0.1.0</version>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Database Migration -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Connection Pool -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- QueryDSL (Optional) -->
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-jpa</artifactId>
            <version>5.1.0</version>
            <classifier>jakarta</classifier>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-apt</artifactId>
            <version>5.1.0</version>
            <classifier>jakarta</classifier>
            <scope>provided</scope>
        </dependency>

        <!-- Database Drivers (Optional - provided by consumer) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Kafka (Optional) - powers KafkaOutboxRelay; gated at runtime by
             @ConditionalOnClass(KafkaTemplate.class) in PersistenceAutoConfiguration so the
             module works fine without it on the classpath. Version managed by the
             Spring Boot BOM (imported via adhar-kit-bom). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Hibernate Envers (Optional) - powers entity revision history; gated at runtime by
             @ConditionalOnClass(AuditReader.class) in PersistenceAutoConfiguration. Envers
             auto-registers with Hibernate when present, so consumers only need to add this
             dependency and annotate entities with org.hibernate.envers.@Audited. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-envers</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Micrometer (Optional - for persistence metrics) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Security (for auditing) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet API (optional: only needed by consumers that register TenantWebFilter in a
             servlet container; pure batch/messaging consumers never pull this in transitively) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Needed only for TenantWebFilterTest's use of org.springframework.mock.web.Mock*
             (spring-test's servlet mocks reference org.springframework.http.MediaType, which lives
             in spring-web; "provided" scope dependencies of our own compile-scope deps, such as
             the jakarta.servlet-api/spring-web brought in transitively, are not themselves
             transitive, so it must be declared directly here). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JaCoCo configuration to exclude generated classes -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Exclude QueryDSL generated classes -->
                        <exclude>**/Q*Entity.class</exclude>
                        <exclude>**/Q*Entity$*.class</exclude>
                        <!-- Exclude repository interfaces (default methods are tested via implementation) -->
                        <exclude>**/repository/*Repository.class</exclude>
                        <exclude>**/outbox/*Repository.class</exclude>
                        <!-- Re-declared explicitly (module build overrides, rather than merges with,
                             the parent's pluginManagement excludes list for this plugin) -->
                        <exclude>**/annotation/**</exclude>
                        <exclude>**/*Properties.class</exclude>
                        <exclude>**/*Properties$*.class</exclude>
                        <exclude>**/*AutoConfiguration.class</exclude>
                        <exclude>**/*AutoConfiguration$*.class</exclude>
                        <exclude>**/*Constants.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <version>5.1.0</version>
                            <classifier>jakarta</classifier>
                        </path>
                        <path>
                            <groupId>jakarta.persistence</groupId>
                            <artifactId>jakarta.persistence-api</artifactId>
                            <version>3.1.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
