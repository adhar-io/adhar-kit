<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.adhar.kit</groupId>
    <artifactId>adhar-kit</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Adhar Kit</name>
    <description>Enterprise-grade microservices platform toolkit with comprehensive support for resilience, observability, and cloud-native patterns</description>
    <url>https://github.com/adhar-io/adhar-kit</url>
    <inceptionYear>2025</inceptionYear>

    <organization>
        <name>Adhar Platform</name>
        <url>https://adhar.io</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>adhar-team</id>
            <name>Adhar Platform</name>
            <email>contact@adhar.io</email>
            <organization>Adhar Platform</organization>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/adhar-io/adhar-kit.git</connection>
        <developerConnection>scm:git:ssh://github.com:adhar-io/adhar-kit.git</developerConnection>
        <url>https://github.com/adhar-io/adhar-kit/tree/main</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/adhar-io/adhar-kit/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/adhar-io/adhar-kit/actions</url>
    </ciManagement>

    <modules>
        <module>adhar-kit-bom</module>
        <module>adhar-kit-parent</module>
        <module>adhar-kit-commons</module>
        <module>adhar-kit-persistence</module>
        <module>adhar-kit-config</module>
        <module>adhar-kit-cache</module>
        <module>adhar-kit-core</module>
        <module>adhar-kit-logging</module>
        <module>adhar-kit-metrics</module>
        <module>adhar-kit-messaging</module>
        <module>adhar-kit-analytics</module>
        <module>adhar-kit-docs</module>
        <module>adhar-kit-grpc</module>
        <module>adhar-kit-security</module>
        <module>adhar-kit-maven-plugin</module>
        <module>adhar-kit-tracing</module>
        <module>adhar-kit-test-commons</module>
        <module>adhar-kit-resilience</module>
        <module>adhar-kit-health</module>
        <module>adhar-kit-kubernetes</module>
        <module>adhar-kit-dapr</module>
        <module>adhar-kit-starter</module>
        <module>adhar-kit-ai</module>
    </modules>

    <profiles>
        <!-- Release Profile -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.10.1</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Coverage Profile -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>